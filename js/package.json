{
  "name": "@vagebond/inertia-typegen",
  "version": "0.1.3",
  "description": "Generate TypeScript types and route helpers for Inertia pages from Scramble's OpenAPI document",
  "license": "MIT",
  "author": "Gianluca Riggio <luca@maximumawesome.nl>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vagebnd/inertia-typegen.git",
    "directory": "js"
  },
  "packageManager": "pnpm@12.14.0",
  "type": "module",
  "files": [
    "dist",
    "runtime"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js"
    }
  },
  "bin": {
    "inertia-typegen": "./dist/cli.js"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && chmod +x dist/cli.js",
    "typecheck": "tsc --noEmit",
    "test": "node --test 'tests/**/*.test.ts'"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "dependencies": {
    "openapi-typescript": "^7.13.0"
  },
  "peerDependencies": {
    "prettier": ">=3.0.0",
    "typescript": ">=5.0.0",
    "vite": ">=6.0.0",
    "vite-plus": "*"
  },
  "peerDependenciesMeta": {
    "prettier": {
      "optional": true
    },
    "vite-plus": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "6.0.3",
    "vite": "^8.3.5"
  }
}
