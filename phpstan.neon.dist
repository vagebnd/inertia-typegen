includes:
    - phpstan-baseline.neon

parameters:
    level: 5
    paths:
        - src
        - config
    tmpDir: build/phpstan
    treatPhpDocTypesAsCertain: false
    ignoreErrors:
        -
            identifier: class.notFound
            path: src/Extensions/TableTypeInfer.php
        -
            identifier: class.notFound
            path: src/Extensions/InertiaExtension.php
